{
  "package": {
    "package": "libpng",
    "usage_frequency": 0.9,
    "performance_criticality": 0.92,
    "dependency_centrality": 0.8,
    "architecture_fit": 1.0,
    "rationale": "Common image path used by browsers, GUI stacks, and tooling"
  },
  "goal": "Optimize Ubuntu 26.04 libpng for the target CPU while preserving surgical replacement compatibility",
  "source_reference": "ubuntu-26.04:libpng:baseline-commit-or-package-version",
  "setup_commands": [["/opt/lda/harness/checks/prepare-ubuntu-source.sh", "libpng1.6"]],
  "baseline_tests": [["/opt/lda/harness/checks/run-baseline-tests.sh"]],
  "dependency_tests": [["/opt/lda/harness/checks/run-dependency-tests.sh"]],
  "abi_checks": [["/opt/lda/harness/checks/run-abi-fence.sh"]],
  "ffi_checks": [["/opt/lda/harness/checks/run-ffi-fence.sh"]],
  "behavior_checks": [["/opt/lda/harness/checks/run-behavior-fence.sh"]],
  "package_lifecycle_checks": [["/opt/lda/harness/checks/run-package-lifecycle.sh"]],
  "security_checks": [["/opt/lda/harness/checks/run-security-fence.sh"]],
  "result_equivalence_checks": [["/opt/lda/harness/checks/run-result-equivalence.sh"]],
  "micro_benchmarks": [
    {
      "name": "libpng-micro",
      "layer": "micro",
      "command": ["/opt/lda/harness/checks/run-micro-benchmark.sh"],
      "baseline_command": ["/opt/lda/harness/checks/run-micro-benchmark.sh", "baseline"],
      "repetitions": 5,
      "timeout_seconds": 900,
      "inputs": ["small", "large", "boundary", "incompressible"]
      ,"max_regression_percent": 0.0
    }
  ],
  "end_to_end_benchmarks": [
    {
      "name": "browser-render-e2e",
      "layer": "end_to_end",
      "command": ["/opt/lda/harness/checks/run-end-to-end-benchmark.sh"],
      "baseline_command": ["/opt/lda/harness/checks/run-end-to-end-benchmark.sh", "baseline"],
      "repetitions": 3,
      "timeout_seconds": 1800,
      "inputs": ["browser-render", "gui", "web-server"]
      ,"max_regression_percent": 5.0
    }
  ],
  "baseline": {
    "mode": "source_package",
    "template": "lda-base",
    "release": "26.04",
    "codename": "resolute",
    "edition": "generic",
    "architecture": "amd64"
  },
  "compatibility": {
    "soname_unchanged": true,
    "exported_symbols_unchanged": true,
    "abi_types_unchanged": true,
    "ffi_call_surface_unchanged": true,
    "behavior_unchanged": true,
    "configuration_preserved": true,
    "security_defaults_preserved": true,
    "result_equivalence_required": true
  },
  "lane": "mainline",
  "metadata": {
    "target_cpu": "INTEL(R) XEON(R) GOLD 6548Y+",
    "target_release": "ubuntu-26.04",
    "optimization_policy": "compatibility-first"
  }
}
