diff --git a/intel/filter_sse2_intrinsics.c b/intel/filter_sse2_intrinsics.c
index 0f3c97a..a374a3a 100644
--- a/intel/filter_sse2_intrinsics.c
+++ b/intel/filter_sse2_intrinsics.c
@@ -116,6 +116,38 @@ png_read_filter_row_sub4_sse2(png_row_infop row_info, png_bytep row,
    PNG_UNUSED(prev)
 }
 
+void
+png_read_filter_row_up_sse2(png_row_infop row_info, png_bytep row,
+    png_const_bytep prev)
+{
+   /* The Up filter predicts each byte as the byte directly above it.  It is
+    * independent of pixel size: d = row[i] + prev[i] (mod 256).  Upstream
+    * leaves this filter to compiler autovectorization ("No need optimize
+    * PNG_FILTER_VALUE_UP" in intel_init.c), but at the package's -O2 that
+    * vectorization does not happen, so the shipped generic code is a scalar
+    * byte loop.  This SSE2 variant processes 16 bytes per iteration with
+    * _mm_add_epi8 and is byte-for-byte identical to the generic result.
+    */
+   size_t rb = row_info->rowbytes;
+
+   png_debug(1, "in png_read_filter_row_up_sse2");
+
+   while (rb >= 16) {
+      __m128i a = _mm_loadu_si128((const __m128i *)row);
+      __m128i b = _mm_loadu_si128((const __m128i *)prev);
+      _mm_storeu_si128((__m128i *)row, _mm_add_epi8(a, b));
+      row  += 16;
+      prev += 16;
+      rb   -= 16;
+   }
+   while (rb > 0) {
+      *row = (png_byte)(*row + *prev);
+      ++row;
+      ++prev;
+      --rb;
+   }
+}
+
 void
 png_read_filter_row_avg3_sse2(png_row_infop row_info, png_bytep row,
     png_const_bytep prev)
diff --git a/intel/filter_sse41_intrinsics.c b/intel/filter_sse41_intrinsics.c
new file mode 100644
index 0000000..01216e3
--- /dev/null
+++ b/intel/filter_sse41_intrinsics.c
@@ -0,0 +1,183 @@
+/* filter_sse41_intrinsics.c - SSE4.1 optimized Paeth filter functions
+ *
+ * Copyright (c) 2018 Cosmin Truta
+ * Copyright (c) 2016-2017 Glenn Randers-Pehrson
+ * Written by Mike Klein and Matt Sarett
+ * Derived from intel/filter_sse2_intrinsics.c
+ *
+ * This code is released under the libpng license.
+ * For conditions of distribution and use, see the disclaimer
+ * and license in png.h
+ */
+
+/* This translation unit provides SSE4.1 variants of the Paeth unfilter.  They
+ * are selected at run time by intel/intel_init.c only when
+ * __builtin_cpu_supports("sse4.1") is true, so the SSE4.1 instructions they
+ * contain are never reachable on the default (SSE2 baseline) dispatch path and
+ * cannot fault on an amd64 CPU that lacks SSE4.1.
+ *
+ * The arithmetic is identical to the PNG_INTEL_SSE_IMPLEMENTATION >= 3 branch
+ * of filter_sse2_intrinsics.c: |x| for 16-bit lanes becomes a single
+ * _mm_abs_epi16, and the bytewise select becomes a single _mm_blendv_epi8.
+ * Because the selection mask originates from _mm_cmpeq_epi16 (0xFFFF/0x0000
+ * per 16-bit lane), _mm_blendv_epi8 selects identically to the SSE2
+ * and/andnot/or expression, so decoded output is byte-for-byte identical to
+ * the SSE2 path.  Only the instruction sequence changes.
+ */
+
+#include "../pngpriv.h"
+
+#ifdef PNG_READ_SUPPORTED
+#if PNG_INTEL_SSE_IMPLEMENTATION > 0
+#ifdef PNG_INTEL_SSE41_RUNTIME
+
+#include <immintrin.h>
+
+#define PNG_SSE41 __attribute__((__target__("sse4.1")))
+
+PNG_SSE41 static __m128i
+load4_41(const void *p)
+{
+   int tmp;
+   memcpy(&tmp, p, sizeof(tmp));
+   return _mm_cvtsi32_si128(tmp);
+}
+
+PNG_SSE41 static __m128i
+load3_41(const void *p)
+{
+   png_uint_32 tmp = 0;
+   memcpy(&tmp, p, 3);
+   return _mm_cvtsi32_si128(tmp);
+}
+
+PNG_SSE41 static void
+store4_41(void *p, __m128i v)
+{
+   int tmp = _mm_cvtsi128_si32(v);
+   memcpy(p, &tmp, sizeof(int));
+}
+
+PNG_SSE41 static void
+store3_41(void *p, __m128i v)
+{
+   int tmp = _mm_cvtsi128_si32(v);
+   memcpy(p, &tmp, 3);
+}
+
+PNG_SSE41 void
+png_read_filter_row_paeth3_sse41(png_row_infop row_info, png_bytep row,
+    png_const_bytep prev)
+{
+   size_t rb;
+   const __m128i zero = _mm_setzero_si128();
+   __m128i c, b = zero,
+           a, d = zero;
+
+   png_debug(1, "in png_read_filter_row_paeth3_sse41");
+
+   rb = row_info->rowbytes;
+   while (rb >= 4) {
+      __m128i pa,pb,pc,smallest,nearest;
+      c = b; b = _mm_unpacklo_epi8(load4_41(prev), zero);
+      a = d; d = _mm_unpacklo_epi8(load4_41(row ), zero);
+
+      /* (p-a) == (a+b-c - a) == (b-c) */
+      pa = _mm_sub_epi16(b,c);
+
+      /* (p-b) == (a+b-c - b) == (a-c) */
+      pb = _mm_sub_epi16(a,c);
+
+      /* (p-c) == (a+b-c - c) == (a+b-c-c) == (b-c)+(a-c) */
+      pc = _mm_add_epi16(pa,pb);
+
+      pa = _mm_abs_epi16(pa);  /* |p-a| */
+      pb = _mm_abs_epi16(pb);  /* |p-b| */
+      pc = _mm_abs_epi16(pc);  /* |p-c| */
+
+      smallest = _mm_min_epi16(pc, _mm_min_epi16(pa, pb));
+
+      /* Paeth breaks ties favoring a over b over c. */
+      nearest  = _mm_blendv_epi8(
+                    _mm_blendv_epi8(c, b, _mm_cmpeq_epi16(smallest, pb)),
+                    a, _mm_cmpeq_epi16(smallest, pa));
+
+      /* Note `_epi8`: we need addition to wrap modulo 255. */
+      d = _mm_add_epi8(d, nearest);
+      store3_41(row, _mm_packus_epi16(d,d));
+
+      prev += 3;
+      row  += 3;
+      rb   -= 3;
+   }
+   if (rb > 0) {
+      __m128i pa,pb,pc,smallest,nearest;
+      c = b; b = _mm_unpacklo_epi8(load3_41(prev), zero);
+      a = d; d = _mm_unpacklo_epi8(load3_41(row ), zero);
+
+      pa = _mm_sub_epi16(b,c);
+      pb = _mm_sub_epi16(a,c);
+      pc = _mm_add_epi16(pa,pb);
+
+      pa = _mm_abs_epi16(pa);
+      pb = _mm_abs_epi16(pb);
+      pc = _mm_abs_epi16(pc);
+
+      smallest = _mm_min_epi16(pc, _mm_min_epi16(pa, pb));
+
+      nearest  = _mm_blendv_epi8(
+                    _mm_blendv_epi8(c, b, _mm_cmpeq_epi16(smallest, pb)),
+                    a, _mm_cmpeq_epi16(smallest, pa));
+
+      d = _mm_add_epi8(d, nearest);
+      store3_41(row, _mm_packus_epi16(d,d));
+
+      prev += 3;
+      row  += 3;
+      rb   -= 3;
+   }
+}
+
+PNG_SSE41 void
+png_read_filter_row_paeth4_sse41(png_row_infop row_info, png_bytep row,
+    png_const_bytep prev)
+{
+   size_t rb;
+   const __m128i zero = _mm_setzero_si128();
+   __m128i pa,pb,pc,smallest,nearest;
+   __m128i c, b = zero,
+           a, d = zero;
+
+   png_debug(1, "in png_read_filter_row_paeth4_sse41");
+
+   rb = row_info->rowbytes+4;
+   while (rb > 4) {
+      c = b; b = _mm_unpacklo_epi8(load4_41(prev), zero);
+      a = d; d = _mm_unpacklo_epi8(load4_41(row ), zero);
+
+      pa = _mm_sub_epi16(b,c);
+      pb = _mm_sub_epi16(a,c);
+      pc = _mm_add_epi16(pa,pb);
+
+      pa = _mm_abs_epi16(pa);
+      pb = _mm_abs_epi16(pb);
+      pc = _mm_abs_epi16(pc);
+
+      smallest = _mm_min_epi16(pc, _mm_min_epi16(pa, pb));
+
+      nearest  = _mm_blendv_epi8(
+                    _mm_blendv_epi8(c, b, _mm_cmpeq_epi16(smallest, pb)),
+                    a, _mm_cmpeq_epi16(smallest, pa));
+
+      d = _mm_add_epi8(d, nearest);
+      store4_41(row, _mm_packus_epi16(d,d));
+
+      prev += 4;
+      row  += 4;
+      rb   -= 4;
+   }
+}
+
+#endif /* PNG_INTEL_SSE41_RUNTIME */
+#endif /* PNG_INTEL_SSE_IMPLEMENTATION > 0 */
+#endif /* PNG_READ_SUPPORTED */
diff --git a/intel/intel_init.c b/intel/intel_init.c
index 9e4610d..334b7b2 100644
--- a/intel/intel_init.c
+++ b/intel/intel_init.c
@@ -27,23 +27,48 @@ png_init_filter_functions_sse2(png_structp pp, unsigned int bpp)
     * but they end up a bit slower than using the equally-ubiquitous SSE2.
    */
    png_debug(1, "in png_init_filter_functions_sse2");
+
+#ifdef PNG_INTEL_SSE41_RUNTIME
+   /* Resolve the CPU's SSE4.1 capability exactly once, outside the per-image
+    * and per-row hot paths.  The SSE4.1 Paeth variants are installed only when
+    * the running CPU advertises SSE4.1; otherwise the SSE2 variants (valid on
+    * any amd64) are kept.  This preserves drop-in behavior on non-SSE4.1 CPUs.
+    */
+   static int have_sse41 = -1;
+   if (have_sse41 < 0)
+      have_sse41 = __builtin_cpu_supports("sse4.1") ? 1 : 0;
+#endif
+
    if (bpp == 3)
    {
       pp->read_filter[PNG_FILTER_VALUE_SUB-1] = png_read_filter_row_sub3_sse2;
+      pp->read_filter[PNG_FILTER_VALUE_UP-1]  = png_read_filter_row_up_sse2;
       pp->read_filter[PNG_FILTER_VALUE_AVG-1] = png_read_filter_row_avg3_sse2;
       pp->read_filter[PNG_FILTER_VALUE_PAETH-1] =
          png_read_filter_row_paeth3_sse2;
+#ifdef PNG_INTEL_SSE41_RUNTIME
+      if (have_sse41)
+         pp->read_filter[PNG_FILTER_VALUE_PAETH-1] =
+            png_read_filter_row_paeth3_sse41;
+#endif
    }
    else if (bpp == 4)
    {
       pp->read_filter[PNG_FILTER_VALUE_SUB-1] = png_read_filter_row_sub4_sse2;
+      pp->read_filter[PNG_FILTER_VALUE_UP-1]  = png_read_filter_row_up_sse2;
       pp->read_filter[PNG_FILTER_VALUE_AVG-1] = png_read_filter_row_avg4_sse2;
       pp->read_filter[PNG_FILTER_VALUE_PAETH-1] =
           png_read_filter_row_paeth4_sse2;
+#ifdef PNG_INTEL_SSE41_RUNTIME
+      if (have_sse41)
+         pp->read_filter[PNG_FILTER_VALUE_PAETH-1] =
+            png_read_filter_row_paeth4_sse41;
+#endif
    }
 
-   /* No need optimize PNG_FILTER_VALUE_UP.  The compiler should
-    * autovectorize.
+   /* PNG_FILTER_VALUE_UP is installed above: at the package's -O2 the
+    * compiler does not autovectorize the generic byte loop, so an explicit
+    * SSE2 (baseline on amd64) variant is used.  It is bpp-independent.
     */
 }
 
diff --git a/pngpriv.h b/pngpriv.h
index a6c91ac..4f9fa46 100644
--- a/pngpriv.h
+++ b/pngpriv.h
@@ -250,6 +250,21 @@
 #   define PNG_INTEL_SSE_IMPLEMENTATION 0
 #endif
 
+/* Run-time SSE4.1 dispatch: when the SSE2 filters are compiled in and the
+ * compiler supports per-function target attributes plus __builtin_cpu_supports
+ * (GCC/Clang on x86), build the SSE4.1 Paeth variants and let intel_init.c
+ * select them only after a one-time CPUID check.  This keeps the default
+ * dispatch path SSE2-only (safe on any amd64) while tuning for CPUs that
+ * advertise SSE4.1.  The baseline ISA is never raised (no -march).
+ */
+#if PNG_INTEL_SSE_IMPLEMENTATION > 0
+#   if defined(__GNUC__) && (defined(__x86_64__) || defined(__i386__))
+#      ifndef PNG_INTEL_SSE41_RUNTIME
+#         define PNG_INTEL_SSE41_RUNTIME 1
+#      endif
+#   endif
+#endif
+
 #if PNG_MIPS_MSA_OPT > 0
 #  ifndef PNG_MIPS_MSA_IMPLEMENTATION
 #     if defined(__mips_msa)
@@ -1628,6 +1643,9 @@ PNG_INTERNAL_FUNCTION(void, png_read_filter_row_sub3_sse2,
 PNG_INTERNAL_FUNCTION(void, png_read_filter_row_sub4_sse2,
    (png_row_infop row_info, png_bytep row, png_const_bytep prev_row),
    PNG_EMPTY);
+PNG_INTERNAL_FUNCTION(void, png_read_filter_row_up_sse2,
+   (png_row_infop row_info, png_bytep row, png_const_bytep prev_row),
+   PNG_EMPTY);
 PNG_INTERNAL_FUNCTION(void, png_read_filter_row_avg3_sse2,
    (png_row_infop row_info, png_bytep row, png_const_bytep prev_row),
    PNG_EMPTY);
@@ -1640,6 +1658,18 @@ PNG_INTERNAL_FUNCTION(void, png_read_filter_row_paeth3_sse2,
 PNG_INTERNAL_FUNCTION(void, png_read_filter_row_paeth4_sse2,
    (png_row_infop row_info, png_bytep row, png_const_bytep prev_row),
    PNG_EMPTY);
+#ifdef PNG_INTEL_SSE41_RUNTIME
+/* Run-time-selected SSE4.1 Paeth variants (see intel/filter_sse41_intrinsics.c
+ * and intel/intel_init.c).  Distinct names keep the SSE2 functions as an
+ * always-valid fallback; both remain internal (hidden) symbols.
+ */
+PNG_INTERNAL_FUNCTION(void, png_read_filter_row_paeth3_sse41,
+   (png_row_infop row_info, png_bytep row, png_const_bytep prev_row),
+   PNG_EMPTY);
+PNG_INTERNAL_FUNCTION(void, png_read_filter_row_paeth4_sse41,
+   (png_row_infop row_info, png_bytep row, png_const_bytep prev_row),
+   PNG_EMPTY);
+#endif /* PNG_INTEL_SSE41_RUNTIME */
 #endif
 
 #if PNG_LOONGARCH_LSX_IMPLEMENTATION == 1
